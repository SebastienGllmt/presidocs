<?xml version="1.0" encoding="UTF-8"?>
<!-- Cross-post pronunciation lexicon for personal-blog. Shared by every post
     here and merged with each post's inline <script type="application/pls+xml">
     at generate time. Add <lexeme>s for terms the TTS engine mispronounces;
     see presidocs/methodology.md → SSML usage for the respelling guidance.
     Excluded from the TTS cache key (editing it doesn't invalidate caches). -->
<lexicon version="1.0"
         xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
         alphabet="ipa" xml:lang="en-US">
  <!-- Example (delete or replace):
  <lexeme>
    <grapheme>presidocs</grapheme>
    <alias>pressy docs</alias>
  </lexeme>
  -->
</lexicon>
