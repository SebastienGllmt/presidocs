{
  "name": "read-demo",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot index.ts",
    "start": "bun index.ts",
    "generate": "bun generate/generate.ts",
    "clean": "bun generate/clean.ts",
    "build": "bun generate/post-meta.ts && bun generate/post-versions.ts && bun build ./index.html ./posts/*.html --outdir ./dist --target browser && bun generate/copy-static.ts && bun generate/strip-served-html.ts",
    "deploy": "bun run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@types/bun": "latest",
    "fast-xml-parser": "^5.7.3",
    "wrangler": "^4.90.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@automerge/automerge": "^3.2.6",
    "arctic": "^3.7.0",
    "shikwasa": "^2.2.1",
    "zod": "^4.4.3"
  }
}
