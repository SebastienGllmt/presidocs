# Session signing key. Required for OAuth login. Generate with:
#   openssl rand -base64 48
# Rotating this value invalidates every active session.
SESSION_SECRET=

# Base URL for OAuth redirect URIs. Defaults to http://localhost:$PORT
# when unset. Set this explicitly for any non-localhost deploy, and make
# sure the redirect URIs you register at Google / Microsoft match
# exactly (down to scheme, host, and port).
# OAUTH_REDIRECT_BASE=https://blog.example.com

# Canonical public origin of the deployed blog (no trailing slash). Used at
# BUILD TIME for absolute URLs in (a) the Schema.org JSON-LD / Open Graph /
# Twitter Card tags (generate/strip-served-html.ts — rich link unfurls +
# Google's "Listen to this article" audio surface) and (b) the Atom + Podcast
# RSS feeds (generate/feeds.ts). Also doubles at RUNTIME as the default base
# for RFC 9457 problem-details `type` URIs (see PROBLEM_BASE_URL below).
# Kept separate from OAUTH_REDIRECT_BASE on purpose: that's the auth-callback
# base, this is the canonical site URL — they happen to coincide today but
# needn't. Unset → build-time injects are skipped (the blog still works, just
# without rich cards / feeds in that deploy).
# SITE_URL=https://blog.example.com

# Base URL for RFC 9457 problem-details `type` URIs (see methodology.md →
# "HTTP error responses"). Resolution chain, highest priority first:
#   1. PROBLEM_BASE_URL (this var) — explicit override
#   2. ${SITE_URL}/probs — inferred from the canonical origin above
#   3. https://blog.example.com/probs — RFC 2606 documentation-reserved
#      fallback. The helper warn-once's on first use of this so a deploy
#      that forgot to set EITHER var is loud at boot.
# Set this only if your problem-type docs live under a DIFFERENT origin than
# the site (rare). Otherwise let SITE_URL drive it — one origin var, no drift.
# PROBLEM_BASE_URL=https://docs.example.com/probs

# URL the build-time "Privacy Policy" footer link points at (see methodology.md
# → Privacy & data protection). The injector (shared/injectFooter.ts) runs in
# the same post-build pass as the structured-data inject and appends one
# <footer class="site-footer"> with a single anchor to every served HTML page.
# Unset → no footer is injected, same fail-silent posture as a missing SITE_URL.
#
# Prefer a SAME-ORIGIN ABSOLUTE PATH ("/privacy") over a full URL: it resolves
# correctly under `bun run dev` (localhost), on preview deploys (*.workers.dev),
# and under the custom domain alike, without having to track SITE_URL. The
# canonical content-repo layout puts the policy at <repo-root>/privacy.html;
# `bun run build` then emits dist/privacy.html which Workers Assets serves at
# /privacy automatically. Use a full URL only when the policy lives on a
# different origin (e.g. a shared corporate /privacy page across multiple blogs).
# PRIVACY_POLICY_URL=/privacy

# --- Subscription feeds (build-time, generate/feeds.ts) ----------------------
# All optional; sensible defaults applied. Feeds only emit when SITE_URL is set.
#
# Feed/channel language and the iTunes podcast category + explicit flag:
# FEED_LANGUAGE=en-US
# PODCAST_CATEGORY=Technology
# PODCAST_EXPLICIT=false
#
# Podcast cover art for <itunes:image> — a site-root path (or absolute URL) to a
# dedicated >=1400px SQUARE image. Apple rejects smaller art, so when this is
# unset the channel image is omitted rather than emitting a too-small one. (The
# per-post 1200x630 social share cards are generated automatically and are a
# separate thing — they're not the podcast cover.)
# PODCAST_COVER=/assets/podcast-cover.png
#
# Stable year for the Atom FEED's own tag-URI id (entries derive their year
# per-post). Set it once to your launch year so the feed identity never moves.
# SITE_LAUNCH_YEAR=2026
#
# Podcast owner contact email. OPT-IN — deliberately NOT pulled from a post's
# <meta name="author-email"> (that address is kept off public surfaces; a feed
# is public). Apple Podcasts *directory submission* requires it; set it only if
# you're submitting there. Omitted from the feed when unset.
# PODCAST_OWNER_EMAIL=you@example.com

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# ID (Web application). Authorized redirect URI:
#   <OAUTH_REDIRECT_BASE>/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft Entra portal → App registrations → New registration.
# "Supported account types" MUST be:
#   "Accounts in any organizational directory (Any Microsoft Entra ID
#    tenant - Multitenant) and personal Microsoft accounts"
# Redirect URI:
#   <OAUTH_REDIRECT_BASE>/auth/microsoft/callback
# After registering, go to Certificates & secrets → New client secret and
# copy the *Value* (not the Secret ID).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Per-post authorship is set per-blog in each post's HTML via:
#   <meta name="author-email" content="you@example.com">
# The server resolves "who's the author of this post?" from that tag
# (see server/postMeta.ts). No env var needed.

# Author moderation list: comma-separated `<provider>:<sub>` userIds
# whose PUTs to /comments are silently accepted but never persisted.
# Leave empty in normal operation. Updates require a redeploy (dev)
# or `wrangler secret put BLOCKED_USERS` (prod) to take effect.
# Example: BLOCKED_USERS=google:1234567890,microsoft:abcdef
BLOCKED_USERS=

# --- MOSS-TTS (offline `bun run generate --tts=moss` only) -------------------
# These are build-time vars for the production voice provider; none are
# needed for the default `say` path. Bun auto-loads .env, so setting
# MOSS_TTS_DIR here lets you run `--tts=moss` without prefixing the command.
#
# Path to your MOSS-TTS checkout (its own repo + venv). Required for
# `--tts=moss`; there is no portable default. The worker runs from here and
# uses <dir>/.venv/bin/python unless MOSS_TTS_PYTHON overrides it.
# MOSS_TTS_DIR=/path/to/MOSS-TTS
#
# Voice-clone reference clips live in the content repo, NOT here. They are
# resolved per post from `<meta name="author-email">` → `authors/<email>.wav`
# (the per-author folder, alongside the author's profile/avatar; see
# methodology.md "Per-author voice resolution"). No env var sets this.
#
# Override the Python interpreter (defaults to <MOSS_TTS_DIR>/.venv/bin/python).
# MOSS_TTS_PYTHON=/path/to/python
#
# Force the torch device (mps/cuda/cpu). Defaults to auto-detect.
# MOSS_TTS_DEVICE=mps
#
# FFmpeg shared-library dir for torchcodec (it dlopen's libavcodec at runtime
# to decode the reference clip). Auto-derived from the `ffmpeg` on PATH; set
# this only if that derivation is wrong for your install.
# MOSS_TTS_FFMPEG_LIB=/opt/homebrew/opt/ffmpeg@8/lib
#
# Cross-segment continuity strategy (proposals/12). Default `instruction`.
#   instruction = give continuing sentences a delivery hint (single-shot;
#                 best on the local 1.7B model)
#   acoustic    = feed the prior segment's audio as multi-turn context
#                 (stronger in theory, but degrades quality on the 1.7B model;
#                 opt-in for experimenting on a larger model)
#   off         = no continuity; every segment is a fresh utterance
# MOSS_TTS_CONTINUATION=instruction

# --- Qwen3 forced aligner (offline, word-level timing — proposals/17) --------
# Build-time only, consumed by generate/aligner.ts and the
# `bun engine/generate/align-check.ts <wav> "<transcript>"` smoke tool. None
# are needed unless you're populating per-word timing for the drawer's
# word-highlight feature or the future social-video subtitle pipeline.
#
# Path to your Qwen3-ForcedAligner checkout (its own repo + venv). Required
# for any aligner call; no portable default. The factory expects
#   <dir>/align.py
#   <dir>/.venv/bin/python           (override via QWEN3_ALIGNER_PYTHON)
#   <dir>/Qwen3-ForcedAligner-0.6B/  (model weights, downloaded once)
# QWEN3_ALIGNER_DIR=/path/to/qwen3-aligner
#
# Override the Python interpreter (defaults to <QWEN3_ALIGNER_DIR>/.venv/bin/python).
# QWEN3_ALIGNER_PYTHON=/path/to/python
#
# Force the torch device. align.py defaults to cuda:0; set to cpu on machines
# without CUDA, or to mps on Apple Silicon if the model supports it there.
# QWEN3_ALIGNER_DEVICE=cpu
