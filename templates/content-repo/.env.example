# personal-blog environment. The engine reads all of these via process.env
# (see presidocs/.env.example for the full annotated list). Bun auto-loads .env.

# Required for OAuth login / comments. Generate: openssl rand -base64 48
SESSION_SECRET=

# Non-localhost deploys: the base URL OAuth redirect URIs are built from.
# OAUTH_REDIRECT_BASE=https://blog.example.com

# Canonical site origin. Gates ALL discovery output — share cards, Atom/podcast
# feeds, and structured data / Open Graph tags only emit when this is set.
# SITE_URL=https://blog.example.com
# Stable launch year for the Atom feed's permanent <id> (defaults to the
# earliest post year; set it once so the feed id never moves).
# SITE_LAUNCH_YEAR=2026
# Podcast cover art (>=1400px square) for <itunes:image>; omitted when unset.
# PODCAST_COVER=/assets/podcast-cover.png
# WebSub hub for real-time feed push: when set, the feeds advertise it via
# <link rel="hub"> and the post-deploy ping notifies it. Opt-in; unset → no-op.
# Use the hub's POST endpoint (not just the homepage), e.g. .../hub.
# WEBSUB_HUB=https://websubhub.com/hub

# --- Publish webhooks (instant Discord/Slack/generic post announcements) -----
# Opt-in, per-blog. On deploy, a genuinely-new post is POSTed to each URL set
# here. SECRETS (anyone holding one can post to the channel) — keep them out of
# git, like SESSION_SECRET. All unset → the step is a no-op. Each var takes a
# comma-separated list for multiple channels. See
# methodology.md → "Subscription feeds".
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# WEBHOOK_URL=https://example.com/hook   # generic {title,url,summary} (Zapier/n8n/homegrown)
# Generic path only — upgrade the body to a CloudEvents envelope:
# WEBHOOK_FORMAT=cloudevents
# Generic path only — sign with Standard Webhooks (base64 secret, whsec_ ok):
# WEBHOOK_SIGNING_SECRET=whsec_...
# Delay (ms) between POSTs when several posts publish at once (default 1100).
# WEBHOOK_PACE_MS=1100

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Author moderation list (comma-separated <provider>:<sub>). Usually empty.
BLOCKED_USERS=

# --- MOSS-TTS (production voice; only for `bun run generate:prod`) -----------
# MOSS_TTS_DIR is your local MOSS-TTS checkout (per-machine path).
# The voice clip is per-blog and committed at authors/<author-email>.wav — the
# per-author folder that also holds the author's profile + avatar (see
# methodology.md "Per-author voice resolution"); nothing voice-related lives
# in .env.
# MOSS_TTS_DIR=/path/to/MOSS-TTS
