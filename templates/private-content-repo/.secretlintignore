# Paths secretlint must NOT scan (gitignore syntax). The scan exists to catch a
# credential accidentally pasted into a *tracked* source file; everything below
# is either not tracked, not text, or is the legitimate (gitignored) secret home.

# Dependencies + build output (not authored, huge, full of vendored entropy).
node_modules/
dist/
generated/
.generated/
.wrangler/

# The engine is consumed via this symlink; scanning it would re-scan the whole
# presidocs tree (its base64/hex test vectors would false-positive). Out of scope.
engine

# The real secret stores — gitignored, and the *intended* home for these
# credentials. Scanning them would flag every legitimately-placed secret.
.env
.env.local
.dev.vars

# Lockfile + heavy / regenerable data artifacts.
bun.lock
*.csv
*.jsonl
*.parquet
*.duckdb
*.duckdb.wal
*.duckdb.tmp

# Binary assets (audio / images / fonts) — not prose, and high-entropy by nature.
*.mp3
*.wav
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
*.woff
*.woff2
*.mp4
*.webm
*.pdf
