# my-private-blog environment. Bun auto-loads .env; keep .dev.vars in sync for
# the wrangler loops (same convention as the public template).

# THE PRIVACY KNOB. With this set, the engine emits no sitemap/feeds/llms.txt,
# injects noindex everywhere, suppresses the Ask-this-blog affordance, and
# audit-private.ts enforces all of it (plus unguessable post slugs) on every
# build. See engine methodology.md → Private blogs.
BLOG_PRIVATE=1

# Required for OAuth login / comments. Generate: openssl rand -base64 48
SESSION_SECRET=

# Canonical site origin — still required on a private blog (canonical links,
# OG absolutes, and the baked SITE_HOST all derive from it).
# SITE_URL=https://private.example.com

# DO NOT set announce channels on a private blog — they push post URLs to
# third parties on deploy, and audit-private.ts fails the build if any is set:
#   DISCORD_WEBHOOK_URL / SLACK_WEBHOOK_URL / WEBHOOK_URL / WEBSUB_HUB

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Author moderation list (comma-separated <provider>:<sub>). Usually empty.
BLOCKED_USERS=
