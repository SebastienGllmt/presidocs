# dependencies
node_modules
# the lockfile a copied blog generates is its own to commit; here the template
# doubles as the engine's e2e fixture (e2e/harness.ts ensureFixtureBlog), whose
# `bun install` must not dirty the engine's tree
bun.lock

# the symlink to the engine checkout (created per-machine — README → Setup —
# or by the e2e fixture bootstrap)
engine

# output
dist
generated

# per-build generated maps + dev route table (regenerated by build / dev)
.generated

# dotenv
.env
.env.local

# Wrangler dev secrets (counterpart of .env for the `dev:edge` loop —
# keep `.dev.vars.example` committed, the real `.dev.vars` carries secrets).
.dev.vars

# Cloudflare wrangler working directory (also persists local Miniflare R2
# state for the dev server's Miniflare-backed COMMENTS binding).
.wrangler

# Finder (macOS)
.DS_Store

# local analysis tooling (e.g. a DuckDB CLI binary under research/)
/tools/

# heavy / regenerable research data artifacts (committed analysis data is .csv)
*.jsonl
*.parquet
*.duckdb
*.duckdb.wal
*.duckdb.tmp
