{
  "$schema": "https://raw.githubusercontent.com/secretlint/secretlint/master/schema/secretlintrc.json",
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Session signing secret",
            "pattern": "/\\bSESSION_SECRETS?\\s*[:=]\\s*[\"']?[A-Za-z0-9+/=:_,.-]{12,}/"
          },
          {
            "name": "OAuth client secret",
            "pattern": "/\\b(?:GOOGLE|MICROSOFT)_OAUTH_CLIENT_SECRET\\s*[:=]\\s*[\"']?\\S{6,}/"
          },
          {
            "name": "VAPID private key",
            "pattern": "/\\bVAPID_PRIVATE_KEY\\s*[:=]\\s*[\"']?\\S{12,}/"
          },
          {
            "name": "Standard Webhooks signing secret",
            "pattern": "/\\bwhsec_[A-Za-z0-9+/=]{16,}/"
          },
          {
            "name": "Discord webhook URL with token",
            "pattern": "/https:\\/\\/discord(?:app)?\\.com\\/api\\/webhooks\\/\\d{15,}\\/[\\w-]{30,}/"
          },
          {
            "name": "Slack webhook URL with token",
            "pattern": "/https:\\/\\/hooks\\.slack\\.com\\/services\\/T[A-Z0-9]{6,}\\/B[A-Z0-9]{6,}\\/[A-Za-z0-9]{20,}/"
          }
        ]
      }
    }
  ]
}
