# dependencies (bun install)
node_modules

# output
out
dist
*.tgz
generated
# ...except the committed e2e fixture audio (espeak narration for the `hello`
# post). The bare `generated` pattern above would swallow it; git can only
# re-include it by un-ignoring the DIRECTORY (a file negation under a still-
# excluded parent does nothing). See e2e/fixture-content/README.md.
!e2e/fixture-content/blog/generated/
proposals

# per-build generated maps + dev route table (regenerated by build / dev)
.generated

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Cloudflare wrangler working directory
.wrangler

# Finder (MacOS) folder config
.DS_Store

# Python bytecode cache
__pycache__/
*.pyc

# local analysis tooling (DuckDB CLI binary)
/tools/

# heavy / regenerable data artifacts. Canonical home is generated/ (already
# ignored above); these extension guards are belt-and-suspenders so a multi-GB
# dump or the DuckDB file can never be committed by accident if it lands
# elsewhere. Committed analysis data is .csv, which is intentionally NOT ignored.
# (Need to commit a deliberate small fixture? `git add -f path.jsonl`.)
*.jsonl
*.parquet
*.duckdb
*.duckdb.wal
*.duckdb.tmp
